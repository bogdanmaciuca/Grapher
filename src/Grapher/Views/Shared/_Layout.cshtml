@using Microsoft.AspNetCore.Identity
@using Grapher.Models
@inject Microsoft.AspNetCore.Identity.UserManager<Grapher.Models.ApplicationUser> UserMgr
@inject Grapher.Data.ApplicationDbContext Context

@{
    var initialTheme = "light";
    if (User.Identity?.IsAuthenticated ?? false)
    {
        var userId = UserMgr.GetUserId(User);
        if (userId != null)
        {
            var profile = await Context.UserProfiles.FindAsync(userId);
            if (profile != null && profile.UsesDarkMode)
            {
                initialTheme = "dark";
            }
        }
    }
}

<!DOCTYPE html>
<html lang="en" data-bs-theme="@initialTheme">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>@ViewData["Title"] - Grapher</title>
        <link rel="icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true" />
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css">
        <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/Grapher.styles.css" asp-append-version="true" />
    </head>
    <body>
        <header>
            <nav class="navbar navbar-expand-lg border-bottom shadow-sm">
                <div class="container-fluid">
                    <a class="navbar-brand fw-bold text-primary" asp-area="" asp-controller="Home" asp-action="Index">Grapher</a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent"
                            aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="navbarSupportedContent">
                        @{
                        var showProjectTaskLinks = false;
                        if (User.Identity?.IsAuthenticated ?? false)
                        {
                            var currentUser = await UserMgr.GetUserAsync(User);
                            showProjectTaskLinks = currentUser != null && !currentUser.IsGuest;
                        }
                        }
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                            @if (showProjectTaskLinks)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Projects" asp-action="Index">Projects</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="TaskItems" asp-action="Index">Tasks</a>
                            </li>
                        }
                        </ul>
                        @if (User.Identity?.IsAuthenticated ?? false)
                        {
                            <button class="btn btn-link nav-link me-2" id="themeToggle" title="Toggle Dark Mode">
                                <i class="bi bi-moon-fill" id="themeIcon"></i>
                            </button>
                        }
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </nav>
        </header>
        <div class="container mt-4">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>

        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
        <script src="~/js/site.js" asp-append-version="true"></script>
        <script>
            document.addEventListener('DOMContentLoaded', () => {
                const themeToggle = document.getElementById('themeToggle');
                const themeIcon = document.getElementById('themeIcon');
                const html = document.documentElement;

                // Set initial icon based on server-rendered attribute
                if (html.getAttribute('data-bs-theme') === 'dark') {
                    themeIcon?.classList.replace('bi-moon-fill', 'bi-sun-fill');
                }

                if (themeToggle) {
                    themeToggle.addEventListener('click', async () => {
                        const currentTheme = html.getAttribute('data-bs-theme');
                        const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
                        
                        html.setAttribute('data-bs-theme', newTheme);
                        
                        if (newTheme === 'dark') {
                            themeIcon.classList.replace('bi-moon-fill', 'bi-sun-fill');
                        } else {
                            themeIcon.classList.replace('bi-sun-fill', 'bi-moon-fill');
                        }

                        // Save to server
                        try {
                            await fetch('/Home/ToggleDarkMode?useDarkMode=' + (newTheme === 'dark'), {
                                method: 'POST'
                            });
                        } catch (e) {
                            console.error('Failed to save theme preference', e);
                        }
                    });
                }
            });
        </script>
        @await RenderSectionAsync("Scripts", required: false)
    </body>
</html>
