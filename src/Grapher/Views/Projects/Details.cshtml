@model Grapher.Models.Project

@{
    ViewData["Title"] = "Project Details";
}

@{
    var inviteSuccess = TempData["InviteSuccess"] as string;
    var inviteError = TempData["InviteError"] as string;
    var summarySuccess = TempData["SummarySuccess"] as string;
    var summaryError = TempData["SummaryError"] as string;
}
@if (!string.IsNullOrEmpty(inviteSuccess))
{
<div class="alert alert-success">@inviteSuccess</div>
}
@if (!string.IsNullOrEmpty(inviteError))
{
<div class="alert alert-danger">@inviteError</div>
}
@if (!string.IsNullOrEmpty(summarySuccess))
{
<div class="alert alert-success">@summarySuccess</div>
}
@if (!string.IsNullOrEmpty(summaryError))
{
<div class="alert alert-danger">@summaryError</div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-dark">@Model.Title</h2>
        <p class="text-muted mb-0">Organizer: @Model.Organizer?.UserName</p>
        @if (Model.StartDate.HasValue)
        {
        <small class="text-muted">Start: @Model.StartDate.Value.ToString("MMMM dd, yyyy")</small>
        }
    </div>

    <div class="d-flex gap-2 align-items-center flex-nowrap">
        @if ((ViewBag.IsOrganizer ?? false) == true)
        {
            <a asp-action="ManageMembers" asp-route-id="@Model.Id" class="btn btn-outline-primary rounded-pill px-3 btn-action text-nowrap">Manage Members</a>
            <button id="openInviteBtn" class="btn btn-outline-primary rounded-pill px-3 btn-action text-nowrap" data-bs-toggle="modal" data-bs-target="#inviteModal">Invite Member</button>
            <form asp-action="GenerateSummary" asp-route-id="@Model.Id" method="post" class="d-inline">
                 <button type="submit" class="btn btn-outline-info rounded-pill px-3 btn-action text-nowrap">Generate AI Summary</button>
            </form>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary rounded-pill px-3 btn-action text-nowrap">Edit</a>
        }
        @if ((ViewBag.IsMember ?? false) == true && (ViewBag.IsOrganizer ?? false) == false)
        {
            <form asp-action="Leave" asp-route-id="@Model.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to leave this project?');">
                <button type="submit" class="btn btn-outline-danger rounded-pill px-3 btn-action text-nowrap">Leave Project</button>
            </form>
        }
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3 btn-action text-nowrap">Back to List</a>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm mb-3" style="border-radius: 12px;">
            <div class="card-body">
                <h5 class="fw-bold">Description</h5>
                <p class="text-muted">@Model.Description</p>

                <hr />

                <dl class="row mb-0">
                    <dt class="col-sm-4 fw-bold">Members</dt>
                    <dd class="col-sm-8">
                        @if (Model.Members != null && Model.Members.Any())
                        {
                        <div class="d-flex flex-wrap gap-1">
                            @foreach (var m in Model.Members)
                            {
                                <span class="badge bg-light text-dark border">@(m.User?.UserName ?? m.UserId)</span>
                            }
                        </div>
                        }
                        else
                        {
                        <span class="text-muted">No members yet</span>
                        }
                    </dd>

                    <dt class="col-sm-4 fw-bold">AI Summary</dt>
                    <dd class="col-sm-8">
                        @if (Model.AiSummary?.SummaryText != null)
                        {
                        <div id="aiSummaryContent" style="white-space: pre-wrap;">@Model.AiSummary.SummaryText</div>
                        }
                        else
                        {
                        <span class="text-muted">No summary available</span>
                        }
                    </dd>
                </dl>
            </div>

            <div class="card-footer bg-white border-0">
                <div class="d-flex justify-content-end">

                </div>
            </div>
        </div>

        @if (Model.Tasks != null && Model.Tasks.Any())
        {
        <div class="card border-0 shadow-sm mb-3" style="border-radius: 12px;">
            <div class="card-body">
                <h5 class="fw-bold mb-3">Task Graph</h5>
                <div class="mermaid">
                    @Html.Raw(ViewBag.MermaidGraph)
                </div>
            </div>
        </div>
        }

        <!-- project tasks preview or other content could go here -->
    </div>
</div>

<h3 class="fw-bold mt-5 mb-3">Kanban Board</h3>
<div class="row g-4">
    <div class="col-md-4">
        <div class="p-3 bg-light rounded shadow-sm h-100">
            <h5 class="fw-bold text-secondary border-bottom pb-2 mb-3 d-flex justify-content-between">
                To Do 
                <span class="badge bg-secondary rounded-pill">@(Model.Tasks?.Count(t => t.Status == Grapher.Models.TaskStatus.NotStarted) ?? 0)</span>
            </h5>
            <div class="kanban-column">
                @if (Model.Tasks != null)
                {
                    foreach (var task in Model.Tasks.Where(t => t.Status == Grapher.Models.TaskStatus.NotStarted))
                    {
                        <div class="card mb-2 border-0 shadow-sm task-card">
                            <div class="card-body p-3">
                                <h6 class="card-title fw-bold"><a asp-controller="TaskItems" asp-action="Details" asp-route-id="@task.Id" class="text-decoration-none text-dark stretched-link">@task.Title</a></h6>
                                <p class="card-text text-muted small text-truncate">@task.Description</p>
                                <div class="d-flex justify-content-between align-items-center mt-2">
                                    <small class="text-muted">@task.Assignments.Count assignee(s)</small>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
    
    <div class="col-md-4">
        <div class="p-3 bg-light rounded shadow-sm h-100">
            <h5 class="fw-bold text-warning border-bottom pb-2 mb-3 d-flex justify-content-between">
                In Progress
                <span class="badge bg-warning text-dark rounded-pill">@(Model.Tasks?.Count(t => t.Status == Grapher.Models.TaskStatus.InProgress) ?? 0)</span>
            </h5>
             <div class="kanban-column">
                @if (Model.Tasks != null)
                {
                    foreach (var task in Model.Tasks.Where(t => t.Status == Grapher.Models.TaskStatus.InProgress))
                    {
                        <div class="card mb-2 border-0 shadow-sm task-card border-start border-4 border-warning">
                             <div class="card-body p-3">
                                <h6 class="card-title fw-bold"><a asp-controller="TaskItems" asp-action="Details" asp-route-id="@task.Id" class="text-decoration-none text-dark stretched-link">@task.Title</a></h6>
                                <p class="card-text text-muted small text-truncate">@task.Description</p>
                                <div class="d-flex justify-content-between align-items-center mt-2">
                                    <small class="text-muted">@task.Assignments.Count assignee(s)</small>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="p-3 bg-light rounded shadow-sm h-100">
             <h5 class="fw-bold text-success border-bottom pb-2 mb-3 d-flex justify-content-between">
                Done
                <span class="badge bg-success rounded-pill">@(Model.Tasks?.Count(t => t.Status == Grapher.Models.TaskStatus.Completed) ?? 0)</span>
            </h5>
             <div class="kanban-column">
                @if (Model.Tasks != null)
                {
                    foreach (var task in Model.Tasks.Where(t => t.Status == Grapher.Models.TaskStatus.Completed))
                    {
                        <div class="card mb-2 border-0 shadow-sm task-card border-start border-4 border-success">
                             <div class="card-body p-3">
                                <h6 class="card-title fw-bold"><a asp-controller="TaskItems" asp-action="Details" asp-route-id="@task.Id" class="text-decoration-none text-dark stretched-link">@task.Title</a></h6>
                                <p class="card-text text-muted small text-truncate">@task.Description</p>
                                <div class="d-flex justify-content-between align-items-center mt-2">
                                    <small class="text-muted">@task.Assignments.Count assignee(s)</small>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

<!-- Invite Modal -->
<div class="modal fade" id="inviteModal" tabindex="-1" aria-labelledby="inviteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <form id="inviteForm" method="post" action="@Url.Action("Invite", "Projects")" class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <h5 class="modal-title" id="inviteModalLabel">Invite Member to Project</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body position-relative">
                <input type="hidden" name="projectId" value="@Model.Id" />
                <div class="mb-3 position-relative">
                    <label for="inviteEmail" class="form-label">Search user by email</label>
                    <input id="inviteEmail" name="email" class="form-control" autocomplete="off" />
                    <div id="inviteSuggestions" class="list-group position-absolute w-100" style="z-index:1050;"></div>
                    <div class="form-text">Type an email or select from suggestions (suggestions limited).</div>
                </div>

                <div id="inviteAlert" class="alert d-none" role="alert"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Close</button>
                <button type="submit" class="btn btn-primary rounded-pill px-4">Send Invitation</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/project-invite.js"></script>
    <script type="module">
        import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs';
        import { marked } from 'https://cdn.jsdelivr.net/npm/marked/lib/marked.esm.js';

        mermaid.initialize({ startOnLoad: true });

        const summaryElement = document.getElementById('aiSummaryContent');
        if (summaryElement) {
            const rawMarkdown = summaryElement.textContent;
            // marked.parse returns a promise if async is enabled, but synchronous by default. 
            // Checking if it returns a promise just in case, though standard ESM usage is sync usually unless configured otherwise.
            // However, the ESM build might be async. Let's check or assume sync for now as per common usage.
            // Actually, recent marked versions are synchronous.
            summaryElement.innerHTML = marked.parse(rawMarkdown);
            summaryElement.style.whiteSpace = 'normal'; 
        }
    </script>
}
