@model Grapher.Models.Project

@{
    ViewData["Title"] = "Project Details";
}

@{
    var inviteSuccess = TempData["InviteSuccess"] as string;
    var inviteError = TempData["InviteError"] as string;
    var summarySuccess = TempData["SummarySuccess"] as string;
    var summaryError = TempData["SummaryError"] as string;
}
@if (!string.IsNullOrEmpty(inviteSuccess))
{
<div class="alert alert-success">@inviteSuccess</div>
}
@if (!string.IsNullOrEmpty(inviteError))
{
<div class="alert alert-danger">@inviteError</div>
}
@if (!string.IsNullOrEmpty(summarySuccess))
{
<div class="alert alert-success">@summarySuccess</div>
}
@if (!string.IsNullOrEmpty(summaryError))
{
<div class="alert alert-danger">@summaryError</div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold">@Model.Title</h2>
        <p class="text-muted mb-0">Organizer: @Model.Organizer?.UserName</p>
        @if (Model.StartDate.HasValue)
        {
        <small class="text-muted">Start: @Model.StartDate.Value.ToString("MMMM dd, yyyy")</small>
        }
    </div>

    <div class="d-flex gap-2 align-items-center flex-nowrap">
        @if ((ViewBag.IsOrganizer ?? false) == true)
        {
            <a asp-action="ManageMembers" asp-route-id="@Model.Id" class="btn btn-outline-primary rounded-pill px-3 btn-action text-nowrap">Manage Members</a>
            <button id="openInviteBtn" class="btn btn-outline-primary rounded-pill px-3 btn-action text-nowrap" data-bs-toggle="modal" data-bs-target="#inviteModal">Invite Member</button>
            <form asp-action="GenerateSummary" asp-route-id="@Model.Id" method="post" class="d-inline">
                 <button type="submit" class="btn btn-outline-info rounded-pill px-3 btn-action text-nowrap">Generate AI Summary</button>
            </form>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary rounded-pill px-3 btn-action text-nowrap">Edit</a>
        }
        @if ((ViewBag.IsMember ?? false) == true && (ViewBag.IsOrganizer ?? false) == false)
        {
            <form asp-action="Leave" asp-route-id="@Model.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to leave this project?');">
                <button type="submit" class="btn btn-outline-danger rounded-pill px-3 btn-action text-nowrap">Leave Project</button>
            </form>
        }
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3 btn-action text-nowrap">Back to List</a>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm mb-3" style="border-radius: 12px;">
            <div class="card-body">
                <h5 class="fw-bold">Description</h5>
                <p class="text-muted">@Model.Description</p>

                <hr />

                <dl class="row mb-0">
                    <dt class="col-sm-4 fw-bold">Members</dt>
                    <dd class="col-sm-8">
                        @if (Model.Members != null && Model.Members.Any())
                        {
                        <div class="d-flex flex-wrap gap-1">
                            @foreach (var m in Model.Members)
                            {
                                <span class="badge bg-secondary-subtle text-secondary-emphasis border">@(m.User?.UserName ?? m.UserId)</span>
                            }
                        </div>
                        }
                        else
                        {
                        <span class="text-muted">No members yet</span>
                        }
                    </dd>

                    <dt class="col-sm-4 fw-bold">AI Summary</dt>
                    <dd class="col-sm-8">
                        @if (Model.AiSummary?.SummaryText != null)
                        {
                        <div id="aiSummaryContent" style="white-space: pre-wrap;">@Model.AiSummary.SummaryText</div>
                        }
                        else
                        {
                        <span class="text-muted">No summary available</span>
                        }
                    </dd>
                </dl>
            </div>

            <div class="card-footer bg-transparent border-0">
                <div class="d-flex justify-content-end">

                </div>
            </div>
        </div>

        @if (Model.Tasks != null && Model.Tasks.Any())
        {
        <div class="card border-0 shadow-sm mb-3" style="border-radius: 12px;">
            <div class="card-body">
                <h5 class="fw-bold mb-3">Task Graph</h5>
                <div class="mermaid">
                    @Html.Raw(ViewBag.MermaidGraph)
                </div>
            </div>
        </div>
        }

        <!-- project tasks preview or other content could go here -->
    </div>
</div>

<h3 class="fw-bold mt-5 mb-3">Kanban Board</h3>
<div class="row g-4">
    <div class="col-md-4">
        <div class="p-3 bg-body-tertiary rounded shadow-sm h-100">
            <h5 class="fw-bold text-secondary border-bottom pb-2 mb-3 d-flex justify-content-between">
                To Do 
                <span id="badge-NotStarted" class="badge bg-secondary rounded-pill">@(Model.Tasks?.Count(t => t.Status == Grapher.Models.TaskStatus.NotStarted) ?? 0)</span>
            </h5>
            <div class="kanban-column" data-status="NotStarted" style="min-height: 200px;">
                @if (Model.Tasks != null)
                {
                    foreach (var task in Model.Tasks.Where(t => t.Status == Grapher.Models.TaskStatus.NotStarted))
                    {
                        <div class="card mb-2 border-0 shadow-sm task-card" draggable="true" data-task-id="@task.Id">
                            <div class="card-body p-3">
                                <h6 class="card-title fw-bold"><a asp-controller="TaskItems" asp-action="Details" asp-route-id="@task.Id" class="text-decoration-none text-body stretched-link">@task.Title</a></h6>
                                <p class="card-text text-muted small text-truncate">@task.Description</p>
                                <div class="d-flex justify-content-between align-items-center mt-2">
                                    <small class="text-muted">@task.Assignments.Count assignee(s)</small>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
    
    <div class="col-md-4">
        <div class="p-3 bg-body-tertiary rounded shadow-sm h-100">
            <h5 class="fw-bold text-warning border-bottom pb-2 mb-3 d-flex justify-content-between">
                In Progress
                <span id="badge-InProgress" class="badge bg-warning text-dark rounded-pill">@(Model.Tasks?.Count(t => t.Status == Grapher.Models.TaskStatus.InProgress) ?? 0)</span>
            </h5>
             <div class="kanban-column" data-status="InProgress" style="min-height: 200px;">
                @if (Model.Tasks != null)
                {
                    foreach (var task in Model.Tasks.Where(t => t.Status == Grapher.Models.TaskStatus.InProgress))
                    {
                        <div class="card mb-2 border-0 shadow-sm task-card border-start border-4 border-warning" draggable="true" data-task-id="@task.Id">
                             <div class="card-body p-3">
                                <h6 class="card-title fw-bold"><a asp-controller="TaskItems" asp-action="Details" asp-route-id="@task.Id" class="text-decoration-none text-body stretched-link">@task.Title</a></h6>
                                <p class="card-text text-muted small text-truncate">@task.Description</p>
                                <div class="d-flex justify-content-between align-items-center mt-2">
                                    <small class="text-muted">@task.Assignments.Count assignee(s)</small>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="p-3 bg-body-tertiary rounded shadow-sm h-100">
             <h5 class="fw-bold text-success border-bottom pb-2 mb-3 d-flex justify-content-between">
                Done
                <span id="badge-Completed" class="badge bg-success rounded-pill">@(Model.Tasks?.Count(t => t.Status == Grapher.Models.TaskStatus.Completed) ?? 0)</span>
            </h5>
             <div class="kanban-column" data-status="Completed" style="min-height: 200px;">
                @if (Model.Tasks != null)
                {
                    foreach (var task in Model.Tasks.Where(t => t.Status == Grapher.Models.TaskStatus.Completed))
                    {
                        <div class="card mb-2 border-0 shadow-sm task-card border-start border-4 border-success" draggable="true" data-task-id="@task.Id">
                             <div class="card-body p-3">
                                <h6 class="card-title fw-bold"><a asp-controller="TaskItems" asp-action="Details" asp-route-id="@task.Id" class="text-decoration-none text-body stretched-link">@task.Title</a></h6>
                                <p class="card-text text-muted small text-truncate">@task.Description</p>
                                <div class="d-flex justify-content-between align-items-center mt-2">
                                    <small class="text-muted">@task.Assignments.Count assignee(s)</small>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

<!-- Invite Modal -->
<div class="modal fade" id="inviteModal" tabindex="-1" aria-labelledby="inviteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <form id="inviteForm" method="post" action="@Url.Action("Invite", "Projects")" class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <h5 class="modal-title" id="inviteModalLabel">Invite Member to Project</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body position-relative">
                <input type="hidden" name="projectId" value="@Model.Id" />
                <div class="mb-3 position-relative">
                    <label for="inviteEmail" class="form-label">Search user by email</label>
                    <input id="inviteEmail" name="email" class="form-control" autocomplete="off" />
                    <div id="inviteSuggestions" class="list-group position-absolute w-100" style="z-index:1050;"></div>
                    <div class="form-text">Type an email or select from suggestions (suggestions limited).</div>
                </div>

                <div id="inviteAlert" class="alert d-none" role="alert"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Close</button>
                <button type="submit" class="btn btn-primary rounded-pill px-4">Send Invitation</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/project-invite.js"></script>
    <script type="module">
        import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs';
        import { marked } from 'https://cdn.jsdelivr.net/npm/marked/lib/marked.esm.js';

        mermaid.initialize({ startOnLoad: true });

        const summaryElement = document.getElementById('aiSummaryContent');
        if (summaryElement) {
            const rawMarkdown = summaryElement.textContent;
            // marked.parse returns a promise if async is enabled, but synchronous by default. 
            // Checking if it returns a promise just in case, though standard ESM usage is sync usually unless configured otherwise.
            // However, the ESM build might be async. Let's check or assume sync for now as per common usage.
            // Actually, recent marked versions are synchronous.
            summaryElement.innerHTML = marked.parse(rawMarkdown);
            summaryElement.style.whiteSpace = 'normal'; 
        }
    </script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const draggables = document.querySelectorAll('.task-card[draggable="true"]');
            const columns = document.querySelectorAll('.kanban-column');

            draggables.forEach(draggable => {
                draggable.addEventListener('dragstart', () => {
                    draggable.classList.add('dragging');
                    draggable.style.opacity = '0.5';
                    const sourceColumn = draggable.closest('.kanban-column');
                    if (sourceColumn) {
                        draggable.setAttribute('data-source-status', sourceColumn.getAttribute('data-status'));
                    }
                });

                draggable.addEventListener('dragend', () => {
                    draggable.classList.remove('dragging');
                    draggable.style.opacity = '1';
                });
            });

            columns.forEach(column => {
                column.addEventListener('dragover', e => {
                    e.preventDefault();
                    const afterElement = getDragAfterElement(column, e.clientY);
                    const draggable = document.querySelector('.dragging');
                    if (draggable) {
                        if (afterElement == null) {
                            column.appendChild(draggable);
                        } else {
                            column.insertBefore(draggable, afterElement);
                        }
                    }
                });

                column.addEventListener('drop', async e => {
                    const draggable = document.querySelector('.dragging');
                    if (!draggable) return;
                    
                    const newStatus = column.getAttribute('data-status');
                    const taskId = draggable.getAttribute('data-task-id');
                    const sourceStatus = draggable.getAttribute('data-source-status');
                    
                    // Call API to update status
                    if (newStatus && taskId) {
                        // Optimistic update for counters if status changed
                        if (sourceStatus && sourceStatus !== newStatus) {
                             updateCounters(sourceStatus, newStatus);
                             updateCardStyle(draggable, newStatus);
                             updateMermaidNode(taskId, newStatus);
                        }

                        try {
                            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                            const response = await fetch('/TaskItems/UpdateStatus', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/x-www-form-urlencoded',
                                    'RequestVerificationToken': token
                                },
                                body: `id=${taskId}&status=${newStatus}`
                            });

                            if (!response.ok) {
                                alert('Failed to update task status.');
                                window.location.reload(); 
                            }
                        } catch (err) {
                            console.error(err);
                            alert('Error updating task status.');
                            window.location.reload();
                        }
                    }
                });
            });

            function getDragAfterElement(container, y) {
                const draggableElements = [...container.querySelectorAll('.task-card:not(.dragging)')];

                return draggableElements.reduce((closest, child) => {
                    const box = child.getBoundingClientRect();
                    const offset = y - box.top - box.height / 2;
                    if (offset < 0 && offset > closest.offset) {
                        return { offset: offset, element: child };
                    } else {
                        return closest;
                    }
                }, { offset: Number.NEGATIVE_INFINITY }).element;
            }

            function updateCardStyle(card, status) {
                card.classList.remove('border-start', 'border-4', 'border-warning', 'border-success');
                if (status === 'InProgress') {
                    card.classList.add('border-start', 'border-4', 'border-warning');
                } else if (status === 'Completed') {
                    card.classList.add('border-start', 'border-4', 'border-success');
                }
            }

            function updateCounters(sourceStatus, newStatus) {
                const sourceBadge = document.getElementById(`badge-${sourceStatus}`);
                const destBadge = document.getElementById(`badge-${newStatus}`);
                
                if (sourceBadge) {
                    let count = parseInt(sourceBadge.innerText);
                    sourceBadge.innerText = Math.max(0, count - 1);
                }
                
                if (destBadge) {
                    let count = parseInt(destBadge.innerText);
                    destBadge.innerText = count + 1;
                }
            }

            function updateMermaidNode(taskId, status) {
                // Determine the new class name based on status
                let newClass = 'notstarted';
                if (status === 'InProgress') newClass = 'inprogress';
                else if (status === 'Completed') newClass = 'completed';

                // Find the SVG node group. Mermaid IDs are usually like "flowchart-T{taskId}-{hash}"
                // We use a prefix selector to find it.
                // The element we need to target for class updates is usually the group <g> having the class "node"
                // The ID is assigned to this group.
                const nodeIdPrefix = `flowchart-T${taskId}-`;
                const nodeGroup = document.querySelector(`g[id^="${nodeIdPrefix}"]`);

                if (nodeGroup) {
                    // Remove existing status classes
                    nodeGroup.classList.remove('notstarted', 'inprogress', 'completed');
                    
                    // Add the new status class
                    nodeGroup.classList.add(newClass);
                }
            }
        });
    </script>
}
