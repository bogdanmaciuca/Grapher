@model Grapher.Models.TaskItem
@using System.Security.Claims
@using System.Text.RegularExpressions

@{
    ViewData["Title"] = "Task Details";
    var attachSuccess = TempData["AttachmentSuccess"] as string;
    var attachError = TempData["AttachmentError"] as string;
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var isAdmin = User.IsInRole("Administrator");
    var isCreator = Model.CreatorId == currentUserId;
    var isProjectOrganizer = Model.Project != null && Model.Project.OrganizerId == currentUserId;
    var canManageAttachments = isAdmin || isCreator || isProjectOrganizer;

    // helpers for provider detection
    Regex ytRegex = new(@"(?:youtube\.com\/(?:watch\?v=|embed\/|v\/)|youtu\.be\/)([A-Za-z0-9_\-]{11})", RegexOptions.IgnoreCase);
    Regex vimeoRegex = new(@"vimeo\.com\/(?:.*#|.*/videos/)?([0-9]+)", RegexOptions.IgnoreCase);

    // permission to edit/delete task according to rules
    var canEdit = isAdmin || isProjectOrganizer || isCreator;
    var canDelete = canEdit;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold">@Model.Title</h2>
    </div>
    <div class="d-flex gap-2">
        @if (canEdit)
        {
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary rounded-pill px-4">Edit</a>
        }
        @if (canDelete)
        {
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger rounded-pill px-4">Delete</a>
        }
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Back to List</a>
    </div>
</div>

@if (!string.IsNullOrEmpty(attachSuccess))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @attachSuccess
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (!string.IsNullOrEmpty(attachError))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @attachError
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row mb-4">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm mb-3" style="border-radius:12px;">
            <div class="card-body">
                <h5 class="fw-bold">Details</h5>
                <dl class="row">
                    <dt class="col-sm-4 fw-bold">Project</dt>
                    <dd class="col-sm-8">@Model.Project?.Title</dd>

                    <dt class="col-sm-4 fw-bold">Created By</dt>
                    <dd class="col-sm-8">@Model.Creator?.UserName</dd>

                    <dt class="col-sm-4 fw-bold">Description</dt>
                    <dd class="col-sm-8">
                        @if (!string.IsNullOrWhiteSpace(Model.Description))
                        {
                        @Model.Description
                        }
                        else
                        {
                        <span class="text-muted">None</span>
                        }
                    </dd>

                    <dt class="col-sm-4 fw-bold">Status</dt>
                    <dd class="col-sm-8">
                        <span class="badge bg-secondary-subtle text-secondary-emphasis border">@Model.Status</span>
                    </dd>

                    <dt class="col-sm-4 fw-bold">Start Date</dt>
                    <dd class="col-sm-8">
                        @if (Model.StartDate != default)
                        {
                        <span>@Model.StartDate.ToString("MMMM dd, yyyy")</span>
                        }
                        else
                        {
                        <span class="text-muted">Not set</span>
                        }
                    </dd>

                    <dt class="col-sm-4 fw-bold">End Date</dt>
                    <dd class="col-sm-8">
                        @if (Model.EndDate.HasValue)
                        {
                        <span>@Model.EndDate.Value.ToString("MMMM dd, yyyy")</span>
                        }
                        else
                        {
                        <span class="text-muted">Not set</span>
                        }
                    </dd>

                    <dt class="col-sm-4 fw-bold align-self-start">Assigned To</dt>
                    <dd class="col-sm-8">
                        @if (Model.Assignments != null && Model.Assignments.Any())
                        {
                        <div class="d-flex flex-wrap gap-1">
                            @foreach (var a in Model.Assignments)
                            {
                            <span class="badge bg-secondary text-white">@(a.User?.UserName ?? a.UserId)</span>
                            }
                        </div>
                        }
                        else
                        {
                        <span class="text-muted">No assignees</span>
                        }
                    </dd>

                    <dt class="col-sm-4 fw-bold">Parent Task</dt>
                    <dd class="col-sm-8">
                        @if (Model.ParentTask != null)
                        {
                        <a asp-action="Details" asp-route-id="@Model.ParentTask.Id">@Model.ParentTask.Title</a>
                        }
                        else
                        {
                        <span class="text-muted">None</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-3" style="border-radius:12px;">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0">Subtasks</h5>
                    @* Optionally link to create a subtask prefilled with ParentTaskId *@
                    @if (User.Identity?.IsAuthenticated ?? false)
                    {
                    <a asp-action="Create" asp-route-parentId="@Model.Id" class="btn btn-sm btn-outline-primary">Create Subtask</a>
                    }
                </div>

                @if (Model.SubTasks != null && Model.SubTasks.Any())
                {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Title</th>
                                <th>Status</th>
                                <th>Assigned</th>
                                <th>Start</th>
                                <th>End</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var st in Model.SubTasks.OrderBy(s => s.StartDate))
                            {
                            var stIsCreator = st.CreatorId == currentUserId;
                            var stIsProjectOrganizer = Model.Project != null && Model.Project.OrganizerId == currentUserId;
                            var stCanEdit = isAdmin || stIsProjectOrganizer || stIsCreator;
                            <tr>
                                <td>
                                    <a asp-action="Details" asp-route-id="@st.Id">@st.Title</a>
                                    <div class="small text-muted">@st.Creator?.UserName</div>
                                </td>
                                <td>@st.Status</td>
                                <td>
                                    @if (st.Assignments != null && st.Assignments.Any())
                                    {
                                        foreach (var a in st.Assignments)
                                        {
                                            <span class="badge bg-secondary text-white me-1">@(a.User?.UserName ?? a.UserId)</span>
                                        }
                                    }
                                </td>
                                <td>@st.StartDate.ToString("yyyy-MM-dd")</td>
                                <td>@(st.EndDate.HasValue ? st.EndDate.Value.ToString("yyyy-MM-dd") : "")</td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@st.Id" class="btn btn-sm btn-outline-primary">View</a>
                                    @if (stCanEdit)
                                    {
                                    <a asp-action="Edit" asp-route-id="@st.Id" class="btn btn-sm btn-outline-secondary ms-1">Edit</a>
                                    }
                                    @if (stCanEdit)
                                    {
                                    <a asp-action="Delete" asp-route-id="@st.Id" class="btn btn-sm btn-outline-danger ms-1">Delete</a>
                                    }
                                </td>
                            </tr>
                            }
                        </tbody>
                    </table>
                </div>
                }
                else
                {
                <div class="text-muted">No subtasks.</div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card border-0 shadow-sm mb-3" style="border-radius:12px;">
            <div class="card-header bg-transparent border-0 user-select-none" style="cursor: pointer;" data-bs-toggle="collapse" data-bs-target="#attachmentsCollapse" aria-expanded="false" aria-controls="attachmentsCollapse">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="fw-bold mb-0">Attachments (@(Model.Attachments?.Count ?? 0))</h5>
                        <span class="text-muted">▼</span>
                    </div>
                </div>
                <div id="attachmentsCollapse" class="collapse">                <div class="card-body pt-0">

                @if (Model.Attachments != null && Model.Attachments.Any())
                {
                <div class="row g-3">
                    @foreach (var a in Model.Attachments)
                        {
                    <div class="col-12">
                        <div class="d-flex align-items-start gap-3">
                            <div style="max-width:640px; width:100%;">
                                @if (!string.Equals(a.Type, "link", StringComparison.OrdinalIgnoreCase))
                                        {
                                <img src="@a.Url" class="img-fluid rounded" alt="attachment" style="max-width:100%; max-height:480px; object-fit:cover;" />
                                        }
                                        else
                                        {
                                            var url = a.Url ?? "";
                                            var ytMatch = ytRegex.Match(url);
                                            var vimeoMatch = vimeoRegex.Match(url);

                                            if (ytMatch.Success)
                                            {
                                                var ytId = ytMatch.Groups[1].Value;
                                                var embed = $"https://www.youtube-nocookie.com/embed/{ytId}?rel=0";
                                <div class="ratio ratio-16x9 mb-2">
                                    <iframe src="@embed" title="YouTube video" allowfullscreen loading="lazy" frameborder="0"></iframe>
                                </div>
                                            }
                                            else if (vimeoMatch.Success)
                                            {
                                                var vId = vimeoMatch.Groups[1].Value;
                                                var embed = $"https://player.vimeo.com/video/{vId}";
                                <div class="ratio ratio-16x9 mb-2">
                                    <iframe src="@embed" title="Vimeo video" allowfullscreen loading="lazy" frameborder="0"></iframe>
                                </div>
                                }
                                else
                                {
                                <a href="@a.Url" target="_blank" rel="noopener noreferrer">@a.Url</a>
                                }
                                        }
                            </div>

                            <div class="flex-grow-1">
                                <div>
                                    <strong>@(string.Equals(a.Type, "link", StringComparison.OrdinalIgnoreCase) ? "Link" : (a.Type?.ToUpperInvariant() ?? "FILE"))</strong>
                                    <span class="small text-muted ms-2">Uploaded by @(a.Uploader?.UserName ?? "Unknown")</span>
                                </div>

                                <div class="mt-2">
                                    @if (canManageAttachments)
                                            {
                                    <form asp-action="RemoveAttachment" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@a.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Remove this attachment?');">Remove</button>
                                    </form>
                                            }
                                </div>
                            </div>
                        </div>
                        <hr />
                    </div>
                        }
                </div>
                }
                else
                {
                <div class="text-muted">No attachments yet.</div>
                }

                @if (canManageAttachments)
                {
                <hr />
                <h6 class="mt-3">Add attachment</h6>

                <form asp-action="UploadAttachment" method="post" enctype="multipart/form-data" class="mb-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="taskId" value="@Model.Id" />
                    <div class="mb-2">
                        <input type="file" name="file" accept=".png,.jpg,.jpeg,.svg,image/*" class="form-control" />
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-sm btn-primary">Upload Image</button>
                    </div>
                    <div class="form-text text-muted">Allowed: png, jpg, jpeg, svg. Max size capped server-side.</div>
                </form>

                <form asp-action="AddAttachmentUrl" method="post" class="mb-0">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="taskId" value="@Model.Id" />
                    <div class="input-group">
                        <input type="url" name="url" class="form-control" placeholder="Paste a link (YouTube, Vimeo, etc.)" />
                        <button class="btn btn-sm btn-outline-secondary" type="submit">Add Link</button>
                    </div>
                </form>
                }
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-3" style="border-radius:12px;">
        <div class="card-header bg-transparent border-0 user-select-none" style="cursor: pointer;" data-bs-toggle="collapse" data-bs-target="#commentsCollapse" aria-expanded="false" aria-controls="commentsCollapse">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0">Comments (@(Model.Comments?.Count ?? 0))</h5>
                <span class="text-muted">▼</span>
            </div>
        </div>
        <div id="commentsCollapse" class="collapse">
            <div class="card-body pt-0">

            @if (Model.Comments != null && Model.Comments.Any())
               {
                <ul class="list-group mb-3">
                    @foreach (var c in Model.Comments.OrderByDescending(cm => cm.PostedAt))
                   {
                       var isCommentAuthor = c.AuthorId == currentUserId;
                       var canRemoveComment = isAdmin || isProjectOrganizer || isCommentAuthor;
                    <li class="list-group-item">
                        <div class="d-flex justify-content-between">
                            <div class="flex-grow-1">
                                <div class="d-flex align-items-baseline justify-content-between">
                                    <div>
                                        <strong>@(c.Author?.UserName ?? c.AuthorId)</strong>
                                        <div class="small text-muted">@c.PostedAt.ToString("g")</div>
                                    </div>
                                </div>
                                <div class="mt-2">
                                    @Html.Raw(System.Net.WebUtility.HtmlEncode(c.Content ?? "").Replace("\n", "<br/>"))
                                </div>
                            </div>

                            @if (canRemoveComment)
                            {
                            <div class="ms-3">
                                <form asp-action="RemoveComment" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@c.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Remove this comment?');">Remove</button>
                                </form>
                            </div>
                            }
                        </div>
                    </li>
                   }
                </ul>
               }
               else
               {
                <div class="text-muted mb-3">No comments yet.</div>
               }

                @if (User.Identity?.IsAuthenticated ?? false)
               {
                <form asp-action="AddComment" method="post" class="mb-0">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="taskId" value="@Model.Id" />
                    <div class="mb-2">
                        <textarea name="content" class="form-control" rows="3" placeholder="Write a comment..."></textarea>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-sm btn-primary">Add Comment</button>
                    </div>
                </form>
               }
            </div>
        </div>
    </div>
    </div>
</div>
