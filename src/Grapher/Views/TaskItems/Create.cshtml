@model Grapher.Models.TaskItem

    @{
    ViewData["Title"] = "Create Task";
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">@ViewData["Title"]</h2>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Back to List</a>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card border-0 shadow-sm" style="border-radius: 12px;">
                <div class="card-body">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="mb-3">
                            <label asp-for="ProjectId" class="form-label fw-bold"></label>
                            <select asp-for="ProjectId" class="form-control" asp-items="ViewBag.ProjectId"></select>
                            <span asp-validation-for="ProjectId" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-bold"></label>
                            <input asp-for="Title" class="form-control" />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-bold"></label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Status" class="form-label fw-bold"></label>
                                <select asp-for="Status" class="form-control" asp-items="Html.GetEnumSelectList<Grapher.Models.TaskStatus>()">
                                </select>
                                <span asp-validation-for="Status" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="EndDate" class="form-label fw-bold"></label>
                                <input asp-for="EndDate" class="form-control" />
                                <span asp-validation-for="EndDate" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label asp-for="ParentTaskId" class="form-label fw-bold">Parent Task (optional)</label>
                            <select asp-for="ParentTaskId" class="form-control" asp-items="ViewBag.ParentTaskId">
                                <option value="">-- none --</option>
                            </select>
                            <span asp-validation-for="ParentTaskId" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Assigned Users</label>
                            <select id="selectedUsers" name="selectedUsers" multiple="multiple" class="form-control" size="8">
                                @* Options will be populated by JS based on project *@
                            </select>
                            <small class="form-text text-muted">Select one or more project members to assign.</small>
                        </div>
                        <div class="d-flex justify-content-end">
                            <input type="submit" value="Create" class="btn btn-primary rounded-pill px-5" />
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var projectSelect = document.getElementById("ProjectId");
            var parentTaskSelect = document.getElementById("ParentTaskId");
            var usersSelect = document.getElementById("selectedUsers");

            function updateParentTasksAndUsers() {
                var projectId = projectSelect.value;
                var currentParentId = parentTaskSelect.value; // Store currently selected parent

                if (!projectId) {
                    parentTaskSelect.innerHTML = '<option value="">-- none --</option>';
                    usersSelect.innerHTML = '';
                    return;
                }

                // Fetch Parent Tasks
                fetch('/TaskItems/GetProjectTasks?projectId=' + projectId)
                    .then(response => response.json())
                    .then(data => {
                        var options = '<option value="">-- none --</option>';
                        data.forEach(function (task) {
                            options += '<option value="' + task.id + '">' + task.title + '</option>';
                        });
                        parentTaskSelect.innerHTML = options;

                        // Try to restore selection if the task is still valid for this project
                        if (currentParentId) {
                            var exists = data.some(t => t.id == currentParentId);
                            if (exists) {
                                parentTaskSelect.value = currentParentId;
                            }
                        }
                    })
                    .catch(error => console.error('Error fetching tasks:', error));

                // Fetch Project Members
                fetch('/TaskItems/GetProjectMembers?projectId=' + projectId)
                    .then(response => response.json())
                    .then(data => {
                        var options = '';
                        data.forEach(function (user) {
                            options += '<option value="' + user.id + '">' + user.userName + '</option>';
                        });
                        usersSelect.innerHTML = options;
                    })
                    .catch(error => console.error('Error fetching members:', error));
            }

            if (projectSelect) {
                projectSelect.addEventListener("change", function() {
                    parentTaskSelect.value = ""; 
                    updateParentTasksAndUsers();
                });
                
                // Initial load
                updateParentTasksAndUsers();
            }
        });
    </script>
    }
