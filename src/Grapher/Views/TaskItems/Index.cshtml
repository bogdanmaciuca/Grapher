@model Grapher.Models.PaginatedList<Grapher.Models.TaskItem>
@using System.Security.Claims

@{
    ViewData["Title"] = "Tasks";
    var pageSize = (int)(ViewData["PageSize"] ?? 10);
    var currentPage = Model.PageIndex;
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var isAdmin = User.IsInRole("Administrator");
}

<div class="mb-3 d-flex justify-content-between align-items-center">
    <h2 class="fw-bold">My Tasks</h2>
    <a asp-action="Create" class="btn btn-primary rounded-pill">Create Task</a>
    <small class="text-muted">Page @Model.PageIndex of @Model.TotalPages</small>
</div>

<form asp-action="Index" method="get" class="row g-3 mb-4 bg-body-tertiary p-3 rounded shadow-sm border">
    <div class="col-md-4">
        <label class="form-label visually-hidden">Search</label>
        <input type="text" name="SearchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Search by title or description..." />
    </div>
    <div class="col-md-3">
        <label class="form-label visually-hidden">Status</label>
        <select name="statusFilter" class="form-select" asp-items="@Html.GetEnumSelectList<Grapher.Models.TaskStatus>()">
            <option value="">-- All Statuses --</option>
        </select>
         @* Retain selected status if possible, manually setting selected not easily supported by asp-items helper without model binding, but helper usually handles if Value matches. 
            Actually, the helper won't automatically select based on ViewData["StatusFilter"]. 
            We can rely on the user re-selecting or use a small script, or explicit options.
            For simplicity with GetEnumSelectList, we might accept it resets or try to bind. 
            Let's stick to simple helper for now, or use JS to set value. *@
    </div>
    <div class="col-md-3">
         <label class="form-label visually-hidden">Sort By</label>
         <select name="sortOrder" class="form-select">
            <option value="">Sort By...</option>
            <option value="date_desc">Date (Newest)</option>
            <option value="date_asc">Date (Oldest)</option>
            <option value="title">Title (A-Z)</option>
            <option value="title_desc">Title (Z-A)</option>
            <option value="status">Status</option>
         </select>
    </div>
    <div class="col-md-2 d-flex gap-2">
        <button type="submit" class="btn btn-primary flex-grow-1">Filter</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

<script>
    // Simple script to set select values from query params (since we aren't using a ViewModel for the form)
    document.addEventListener("DOMContentLoaded", function() {
        const urlParams = new URLSearchParams(window.location.search);
        const status = urlParams.get('statusFilter');
        const sort = urlParams.get('sortOrder');
        
        if(status) document.querySelector('select[name="statusFilter"]').value = status;
        if(sort) document.querySelector('select[name="sortOrder"]').value = sort;
    });
</script>

<div class="row row-cols-1 row-cols-md-3 g-4 mb-5">
    @foreach (var item in Model)
    {
        var isProjectOrganizer = item.Project != null && item.Project.OrganizerId == currentUserId;
        var isAssigned = item.Assignments != null && item.Assignments.Any(a => a.UserId == currentUserId);
        var canEdit = isAdmin || isProjectOrganizer || isAssigned;
        var canDelete = isAdmin || isProjectOrganizer || isAssigned;

        <div class="col">
            <div class="card h-100 border shadow-sm shadow-hover" style="border-radius: 12px; transition: 0.2s;">
                <div class="card-body d-flex flex-column">
                    <div class="mb-3">
                        <h5 class="card-title fw-bold mb-1">
                            <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none text-body stretched-link">
                                @item.Title
                            </a>
                        </h5>
                        <small class="text-muted">
                            Project: @(item.Project != null ? item.Project.Title : "N/A")
                        </small>
                    </div>

                    <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center">
                        <span class="badge bg-secondary-subtle text-secondary-emphasis border">
                            Status: @item.Status
                        </span>
                        @if (item.EndDate.HasValue)
                        {
                        <span class="badge bg-secondary-subtle text-secondary-emphasis border">
                            Due: @item.EndDate.Value.ToString("MMM dd, yyyy")
                        </span>
                        }
                    </div>
                </div>

                <div class="card-footer bg-transparent border-0 pt-0 pb-3">
                    <div class="d-flex justify-content-end gap-2" style="position: relative; z-index: 2;">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">View</a>
                        @if (canEdit)
                        {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary rounded-pill px-3">Edit</a>
                        }
                        @if (canDelete)
                        {
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger rounded-pill px-3">Delete</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<hr />
<nav aria-label="Page navigation">
    <ul class="pagination">
        @{
            var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
            var nextDisabled = !Model.HasNextPage ? "disabled" : "";
        }
        <li class="page-item @prevDisabled">
            <a class="page-link" asp-action="Index"
               asp-route-sortOrder="@ViewData["CurrentSort"]"
               asp-route-page="@(Model.PageIndex - 1)"
               asp-route-currentFilter="@ViewData["CurrentFilter"]"
               asp-route-statusFilter="@ViewData["StatusFilter"]"
               aria-label="Previous">
                <span aria-hidden="true">&laquo;</span>
            </a>
        </li>

        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                <a class="page-link" asp-action="Index"
                   asp-route-sortOrder="@ViewData["CurrentSort"]"
                   asp-route-page="@i"
                   asp-route-currentFilter="@ViewData["CurrentFilter"]"
                   asp-route-statusFilter="@ViewData["StatusFilter"]">@i</a>
            </li>
        }

        <li class="page-item @nextDisabled">
            <a class="page-link" asp-action="Index"
               asp-route-sortOrder="@ViewData["CurrentSort"]"
               asp-route-page="@(Model.PageIndex + 1)"
               asp-route-currentFilter="@ViewData["CurrentFilter"]"
               asp-route-statusFilter="@ViewData["StatusFilter"]"
               aria-label="Next">
                <span aria-hidden="true">&raquo;</span>
            </a>
        </li>
    </ul>
</nav>
